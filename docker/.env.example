# openoutreach-docker — plantilla de variables de entorno
#
# Copiar a `.env` (NO versionar el .env real) y completar.
# Verificar los nombres exactos contra docs/configuration.md de openoutfind y openoutsend
# antes de usarlos en producción (paso F0 del PLAN).

# ---- Panel web ----
PANEL_USER=admin
PANEL_PASSWORD_HASH=            # hash, no texto plano
PANEL_BIND=127.0.0.1
PANEL_PORT=8080

# ---- OpenOutFind (búsqueda / calificación) ----
OPENOUTFIND_PRODUCT_DOCS_FILE=/content/product.md
OPENOUTFIND_CAMPAIGN_TARGET_FILE=/content/target.md
OPENOUTFIND_LLM_API_KEY=
OPENOUTFIND_LLM_API_BASE=
OPENOUTFIND_LLM_MODEL=
OPENOUTFIND_BETTERCONTACT_API_KEY=
OPENOUTFIND_OPERATOR_EMAIL=
OPENOUTFIND_OPERATOR_COUNTRY=CL

# ---- OpenOutSend (envío) ----
OUTSEND_AI_MODEL=
OUTSEND_LLM_API_KEY=
OUTSEND_LLM_API_BASE=
OUTSEND_PRODUCT_DOCS=
OUTSEND_CAMPAIGN_TARGET=
OUTSEND_OPERATOR_NAME=
OUTSEND_OPERATOR_EMAIL=
OUTSEND_MAILBOX_ADDRESS=
OUTSEND_MAILBOX_PASSWORD=       # app password, no la contraseña de la cuenta
OUTSEND_SIGNATURE=
OUTSEND_FOLLOW_UPS=on
# OUTSEND_TRANSPORT=mailbox     # o "resend"
# OUTSEND_RESEND_API_KEY=
# OUTSEND_DAILY_CAP=50

# ---- Rutas dentro del contenedor ----
OPENOUTREACH_DB=/app/data/db.sqlite3
OUTSEND_HOME=/app/state
